# CareLoop — environment template. Copy to .env and fill in.
# .env is gitignored; never commit real values.

# App
APP_ENV=development
APP_SECRET=change-me-local-only
DEMO_USER_EMAIL=maya.patel@careloop.demo
DEMO_USER_PASSWORD=demo-only-password
# Host ports 3002/8002/3101: 3000, 8000, and 3100 are occupied by other
# stacks on the demo machine (see infra/README.md).
FRONTEND_URL=http://localhost:3002
BACKEND_URL=http://localhost:8002
NEXT_PUBLIC_WS_BASE=ws://localhost:8002

# OpenAI  (user supplies key; model verified against real key at backend startup)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano       # cheapest available; verified at startup (quality-gated by verify scripts)
OPENAI_EVAL_MODEL=gpt-5-nano  # cheapest for model-graded evaluators
OPENAI_REASONING_EFFORT=low   # nano default effort is ~21s/call; low is ~4s with sharp output
OPENAI_GENERATION_MODEL=gpt-5-mini  # care plan + reports (guarantee-carrying); rest runs OPENAI_MODEL

# Deepgram  (user supplies key)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-medical
DEEPGRAM_DIARIZE_MODEL=latest

# App Postgres (internal to compose network)
APP_DATABASE_URL=postgresql+asyncpg://careloop:careloop-local@app-postgres:5432/careloop
APP_POSTGRES_USER=careloop
APP_POSTGRES_PASSWORD=careloop-local
APP_POSTGRES_DB=careloop

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=careloop-neo4j-local

# Langfuse client (pinned deterministic keys — must MATCH the LANGFUSE_INIT_* values below; spec §19)
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk-lf-careloop-demo-0000000000000001
LANGFUSE_SECRET_KEY=sk-lf-careloop-demo-0000000000000001

# Langfuse headless initialization (first boot on empty volume only; reset-demo recreates volumes)
LANGFUSE_INIT_ORG_ID=careloop-org
LANGFUSE_INIT_ORG_NAME="CareLoop Demo Org"
LANGFUSE_INIT_PROJECT_ID=careloop-project
LANGFUSE_INIT_PROJECT_NAME=CareLoop
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-careloop-demo-0000000000000001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-careloop-demo-0000000000000001
LANGFUSE_INIT_USER_EMAIL=admin@careloop.demo
LANGFUSE_INIT_USER_NAME="CareLoop Admin"
LANGFUSE_INIT_USER_PASSWORD=careloop-langfuse-local

# Langfuse infrastructure (per current official compose — infra agent fills any additional
# required vars here with generated local-only values; see infra/langfuse/README.md)
LANGFUSE_POSTGRES_PASSWORD=langfuse-pg-local
CLICKHOUSE_PASSWORD=clickhouse-local
REDIS_AUTH=redis-local
MINIO_ROOT_PASSWORD=minio-local-password
LANGFUSE_SALT=careloop-local-salt-change-me
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=careloop-nextauth-local
